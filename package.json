{
  "name": "agentic-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --experimental-sqlite node_modules/next/dist/bin/next dev",
    "build": "node --experimental-sqlite node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node --experimental-sqlite .next/standalone/server.js",
    "lint": "eslint",
    "test": "node --experimental-sqlite node_modules/vitest/vitest.mjs run",
    "demo": "SCOUT_DEMO=1 node --experimental-sqlite node_modules/vitest/vitest.mjs run lib/demo.test.ts",
    "live": "SCOUT_LIVE=1 node --env-file=.env.local --experimental-sqlite node_modules/vitest/vitest.mjs run lib/live-search.test.ts",
    "test:coverage": "node --experimental-sqlite node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
